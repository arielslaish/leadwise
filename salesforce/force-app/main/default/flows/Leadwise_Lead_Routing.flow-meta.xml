        <label>Route Hot</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varQueueName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fxRegionQueue</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varCreateTask</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
