    <constants>
        <description>Score at or above which a lead routes as Hot. Mirrors the slider in the Leadwise UI.</description>
        <name>HotThreshold</name>
        <dataType>Number</dataType>
        <value>
            <numberValue>75.0</numberValue>
        </value>
    </constants>
    <constants>
        <description>Days until the first-call task on a Hot lead is due. Mirrors the SLA slider in the Leadwise UI.</description>
        <name>HotTaskDueDays</name>
        <dataType>Number</dataType>
        <value>
            <numberValue>1.0</numberValue>
        </value>
    </constants>
    <constants>
        <description>When true, Hot Enterprise leads go to the Strategic Accounts queue instead of regional AEs.</description>
        <name>RouteEnterpriseToStrategic</name>
        <dataType>Boolean</dataType>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </constants>
    <constants>
        <description>Days until the SDR outreach task on a Warm lead is due.</description>
        <name>WarmTaskDueDays</name>
        <dataType>Number</dataType>
        <value>
            <numberValue>3.0</numberValue>
        </value>
    </constants>
    <constants>
        <description>Score at or above which a lead goes to SDRs instead of Nurture.</description>
        <name>WarmThreshold</name>
        <dataType>Number</dataType>
        <value>
            <numberValue>55.0</numberValue>
        </value>
    </constants>
    <decisions>
        <name>Decide_Route</name>
        <label>Decide Route</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Route_Nurture</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Nurture</defaultConnectorLabel>
        <rules>
            <name>Disqualify</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Lead_Tier__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Disqualify</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Route_Disqualify</targetReference>
            </connector>
            <label>Disqualify</label>
        </rules>
        <rules>
            <name>Strategic</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Lead_Score__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>HotThreshold</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Segment__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Enterprise</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>RouteEnterpriseToStrategic</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Route_Strategic</targetReference>
            </connector>
            <label>Strategic</label>
        </rules>
        <rules>
            <name>Hot</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Lead_Score__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>HotThreshold</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Route_Hot</targetReference>
            </connector>
            <label>Hot</label>
        </rules>
        <rules>
            <name>Warm</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Lead_Score__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>WarmThreshold</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Route_Warm</targetReference>
            </connector>
            <label>Warm</label>
        </rules>
    </decisions>
    <decisions>
        <name>Needs_Task</name>
        <label>Needs Task?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No task</defaultConnectorLabel>
        <rules>
            <name>Create_Follow_Up</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCreateTask</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Task</targetReference>
            </connector>
            <label>Create follow-up</label>
        </rules>
    </decisions>
    <description>Leadwise lead routing. After a Lead is created with a Leadwise score: Disqualify goes to Data Hygiene, Hot goes to the regional AE queue (or Strategic Accounts for Enterprise, when enabled) with a High-priority call task due within the SLA, Warm goes to the SDR queue with an outreach task, everything else goes to Marketing Nurture.</description>
    <environments>Default</environments>
    <formulas>
        <description>Next business touch for Hot leads: today plus the SLA constant.</description>
        <name>fxHotDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + {!HotTaskDueDays}</expression>
    </formulas>
    <formulas>
        <description>Queue developer name for Hot leads, by region.</description>
        <name>fxRegionQueue</name>
        <dataType>String</dataType>
        <expression>CASE({!$Record.Region__c},
  &quot;North America&quot;, &quot;AMER_AE_Queue&quot;,
  &quot;Israel&quot;, &quot;ISR_AE_Queue&quot;,
  &quot;UK&quot;, &quot;EMEA_AE_Queue&quot;,
  &quot;DACH&quot;, &quot;EMEA_AE_Queue&quot;,
  &quot;Rest of Europe&quot;, &quot;EMEA_AE_Queue&quot;,
  &quot;ANZ&quot;, &quot;APAC_AE_Queue&quot;,
  &quot;Global_AE_Queue&quot;)</expression>
    </formulas>
    <formulas>
        <name>fxWarmDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + {!WarmTaskDueDays}</expression>
    </formulas>
    <interviewLabel>Leadwise Lead Routing {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Leadwise Lead Routing</label>
    <processMetadataValues>
