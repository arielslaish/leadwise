# Copy to .env.local and fill in. Never commit .env.local.

# Anthropic (server-side only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Rate limiting (Upstash Redis via Vercel Marketplace, free tier).
# Required in production: without it the scoring API refuses all requests.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DAILY_UPLOADS_PER_IP=3
DAILY_UPLOADS_GLOBAL=150

# Download notification email (Resend free tier)
RESEND_API_KEY=
NOTIFY_EMAIL=
# NOTIFY_FROM=Lead Engine <hello@yourdomain.com>  # only after verifying a domain
