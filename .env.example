# Copy to .env.local and fill in. Never commit .env.local.

# Anthropic (server-side only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Salesforce dev org: External Client App with Client Credentials flow
SF_LOGIN_URL=https://YOUR-DOMAIN.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Rate limiting (Upstash Redis via Vercel Marketplace, free tier)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
